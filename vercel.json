{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "myjournalview.com"
        }
      ],
      "destination": "https://www.myjournalview.com/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://*.doubleclick.net https://*.google.com https://*.google https://*.googlesyndication.com https://vercel.live; frame-ancestors 'none';"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/video-feed.xml",
      "destination": "/api/video-feed"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/article-sitemap.xml",
      "destination": "/api/article-sitemap"
    },
    {
      "source": "/page-sitemap.xml",
      "destination": "/api/page-sitemap"
    },
    {
      "source": "/image-sitemap.xml",
      "destination": "/api/image-sitemap"
    },
    {
      "source": "/video-sitemap.xml",
      "destination": "/api/video-sitemap"
    },
    {
      "source": "/:type((?:[pP]lace|[gG]allery|[vV]ideos))/:slug([^/]*[A-Z][^/]*)",
      "destination": "/api/og-metadata?type=:type&slug=:slug"
    },
    {
      "source": "/videos/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|twitterbot|facebookexternalhit|facebot|meta-externalagent|meta-externalfetcher|whatsapp|telegram|pinterest|linkedin|slack|discord|instagram|tiktok|xbot|yandex|baidu|duckduck|applebot|bingbot|google-inspectiontool|googleother|gptbot|chatgpt-user|perplexity|perplexity-user|claudebot|claude-user|microsoftpreview|cohere|bytespider|mediapartners-google).*"
        }
      ],
      "destination": "/api/og-metadata?type=videos&slug=:slug"
    },
    {
      "source": "/:type([vV]ideos)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|twitterbot|facebookexternalhit|facebot|meta-externalagent|meta-externalfetcher|whatsapp|telegram|pinterest|linkedin|slack|discord|instagram|tiktok|xbot|yandex|baidu|duckduck|applebot|bingbot|google-inspectiontool|googleother|gptbot|chatgpt-user|perplexity|perplexity-user|claudebot|claude-user|microsoftpreview|cohere|bytespider|mediapartners-google).*"
        }
      ],
      "destination": "/api/og-metadata?type=video-gallery"
    },
    {
      "source": "/:type((?:[pP]lace|[gG]allery|[vV]ideos))/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|twitterbot|facebookexternalhit|facebot|meta-externalagent|meta-externalfetcher|whatsapp|telegram|pinterest|linkedin|slack|discord|instagram|tiktok|xbot|yandex|baidu|duckduck|applebot|bingbot|google-inspectiontool|googleother|gptbot|chatgpt-user|perplexity|perplexity-user|claudebot|claude-user|microsoftpreview|cohere|bytespider|mediapartners-google).*"
        }
      ],
      "destination": "/api/og-metadata?type=:type&slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
